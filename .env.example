# URL of your deployed Modal app (from `modal deploy modal_app.py`)
MODAL_API_URL=https://<your-workspace>--karaokengen-api.modal.run

# Shared secret for the Modal API. REQUIRED now: if this is empty, the
# deployed API accepts requests from anyone who finds the URL (they can
# burn your GPU credits). Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(16))"
# and keep it in sync across machines that run the local app.
# NOTE: .env is gitignored — copy it to each machine yourself.
MODAL_API_KEY=