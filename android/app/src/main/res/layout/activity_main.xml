<?xml version="1.0" encoding="utf-8"?>
<!-- One page: home form, the native editor (takes over the
     whole screen once an alignment finishes) and the jobs list
     all live here, switched by visibility. The sidebar
     (NavigationView) holds Home, Jobs, Backend settings and
     Copy logs. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/kg_panel"
            app:title="@string/app_name"
            app:titleTextColor="@color/kg_text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- HOME: the existing form (link, lyrics, genre, language, Start). -->
            <ScrollView
                android:id="@+id/homeView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingTop="20dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="20dp">

                    <!-- In-app update banner (shown only when a newer APK release exists). -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/updateCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/updateTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/update_available"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <TextView
                                android:id="@+id/updateText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/update_install_prompt"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />

                            <ProgressBar
                                android:id="@+id/updateProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:max="100"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/updateButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/update_now" />

                                <Button
                                    android:id="@+id/updateLaterButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/update_later"
                                    style="?attr/materialButtonOutlinedStyle" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_title"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/main_subtitle"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/youtube_url_label"
                        app:placeholderText="@string/youtube_url_hint"
                        app:boxBackgroundColor="@color/kg_input_bg"
                        app:boxStrokeColor="@color/text_input_stroke">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/urlInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/lyrics_label"
                        app:placeholderText="@string/lyrics_hint"
                        app:boxBackgroundColor="@color/kg_input_bg"
                        app:boxStrokeColor="@color/text_input_stroke">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/lyricsInput"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:scrollbars="vertical" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Audio player: hear the song while fixing the
                         lyrics. Shown once the audio file is ready. -->
                    <LinearLayout
                        android:id="@+id/audioPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/playerPlayButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/player_play"
                            style="?attr/materialButtonOutlinedStyle" />

                        <SeekBar
                            android:id="@+id/playerSeekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/playerTimeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="0:00 / 0:00"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />
                    </LinearLayout>

                    <!-- No checkbox: leaving lyrics empty means "transcribe" automatically. -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/genre_label"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <RadioGroup
                        android:id="@+id/genreGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/genreHiphop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/genre_hiphop" />

                        <RadioButton
                            android:id="@+id/genreBallad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/genre_ballad" />
                    </RadioGroup>

                    <!-- Song language (same three choices as the desktop editor).
                         Auto-detect picks from the lyrics text; it never sends a
                         blank language, because the backend accepts "" but its
                         aligner requires a concrete code and dies on "". -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/language_label"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <RadioGroup
                        android:id="@+id/languageGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/langTagalog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/lang_tagalog" />

                        <RadioButton
                            android:id="@+id/langEnglish"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/lang_english" />

                        <RadioButton
                            android:id="@+id/langAuto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/lang_auto" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/startButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/start" />

                    <ProgressBar
                        android:id="@+id/audioProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/audioStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/audioResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/draftProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/draftStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <TextView
                        android:id="@+id/draftResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/cancelButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/cancel_draft"
                        android:visibility="gone"
                        style="?attr/materialButtonOutlinedStyle" />

                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/kg_error"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />

                </LinearLayout>
            </ScrollView>

            <!-- JOBS: the job queue (sidebar). Simple list, newest first. -->
            <ScrollView
                android:id="@+id/jobsView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jobs_title"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium" />

                    <TextView
                        android:id="@+id/jobsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/jobs_empty"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <LinearLayout
                        android:id="@+id/jobsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>

            <!-- EDITOR: native editor (no WebView) — takes over the
                 whole screen when an alignment finishes. The waveform
                 + playback stay pinned at the top; the tappable words
                 scroll below them; render controls sit at the bottom. -->
            <LinearLayout
                android:id="@+id/editorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp">

                <!-- Header: back to the form + the song being edited. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/editorBackButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/editor_back"
                        style="?attr/materialButtonOutlinedStyle" />

                    <TextView
                        android:id="@+id/editorSongTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/editorStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/editorLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Waveform with draggable word regions — pinned at the top. -->
                <com.lukatdamoves.karaokegen.WaveformView
                    android:id="@+id/editorWaveform"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp" />

                <!-- Zoom: less time across the width. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_zoom" />

                    <SeekBar
                        android:id="@+id/editorZoomBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:max="100" />
                </LinearLayout>

                <!-- Playback: play the vocals, jump between lines. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/editorPrevButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/editor_prev"
                        style="?attr/materialButtonOutlinedStyle" />

                    <Button
                        android:id="@+id/editorPlayButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/player_play" />

                    <Button
                        android:id="@+id/editorNextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/editor_next"
                        style="?attr/materialButtonOutlinedStyle" />

                    <TextView
                        android:id="@+id/editorTimeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="0:00 / 0:00"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>

                <!-- Word list: tap a word to play just it,
                     long-press it to fix its text. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/editor_words_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <!-- Tappable words — scrollable, takes the remaining
                     space so the waveform stays pinned at the top. -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/editorWordList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/editorAddLineButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/editor_add_line"
                        style="?attr/materialButtonOutlinedStyle" />

                    <Button
                        android:id="@+id/editorUndoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/editor_undo"
                        style="?attr/materialButtonOutlinedStyle" />
                </LinearLayout>

                <!-- Render: background colour + Render MP4. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/editor_render_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/editor_bg_label" />

                    <View
                        android:id="@+id/editorSwatchBlack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/editor_bg_black" />

                    <View
                        android:id="@+id/editorSwatchNavy"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/editor_bg_navy" />

                    <View
                        android:id="@+id/editorSwatchWhite"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/editor_bg_white" />
                </LinearLayout>

                <Button
                    android:id="@+id/editorRenderButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/editor_render" />

                <TextView
                    android:id="@+id/editorRenderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/editorDownloadButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/editor_download"
                    android:visibility="gone"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- Sidebar. -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
