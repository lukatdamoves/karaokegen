    <string name="backend_stale_text">The saved address is outdated — tap “Set up my backend” below to reconnect. It usually takes under a minute.</string>
    <string name="backend_none_title">No backend set up yet</string>
    <string name="backend_none_text">Paste your Modal token below and tap “Set up my backend”.</string>
